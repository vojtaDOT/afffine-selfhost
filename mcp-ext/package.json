{
  "name": "affine-mcp-ext",
  "version": "1.3.0",
  "description": "MCP proxy that extends AFFiNE's built-in MCP server with additional tools sourced from the GraphQL API and write tools built on Yjs CRDT",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "fix-duplicate-refs": "tsx src/fix-duplicate-refs.ts"
  },
  "dependencies": {
    "fractional-indexing": "^3.2.0",
    "nanoid": "^5.0.7",
    "socket.io-client": "^4.8.1",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
